{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs gerais",
      "queryLines": [
        "SELECT\n",
        "  SUM(revenue)                                          AS revenue,\n",
        "  SUM(orders)                                           AS orders,\n",
        "  SUM(units_sold)                                       AS units_sold,\n",
        "  SUM(revenue) / SUM(orders)                            AS avg_ticket,\n",
        "  COUNT(DISTINCT CASE WHEN orders > 0 THEN franchise_id END) AS active_franchises,\n",
        "  COUNT(DISTINCT country)                               AS countries\n",
        "FROM daily_sales_by_franchise\n"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Receita diária",
      "queryLines": [
        "SELECT sale_date, SUM(revenue) AS revenue, SUM(orders) AS orders\n",
        "FROM daily_sales_by_franchise\n",
        "GROUP BY sale_date\n",
        "ORDER BY sale_date\n"
      ]
    },
    {
      "name": "ds_payment",
      "displayName": "Mix de meio de pagamento",
      "queryLines": [
        "SELECT\n",
        "  CASE payment_method\n",
        "    WHEN 'amex'       THEN 'American Express'\n",
        "    WHEN 'mastercard' THEN 'Mastercard'\n",
        "    WHEN 'visa'       THEN 'Visa'\n",
        "    ELSE initcap(payment_method)\n",
        "  END AS payment_method,\n",
        "  SUM(revenue) AS revenue,\n",
        "  SUM(orders)  AS orders\n",
        "FROM daily_sales_by_franchise\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_product",
      "displayName": "Vendas por produto",
      "queryLines": [
        "SELECT product, orders, units_sold, revenue, revenue_share, revenue_rank\n",
        "FROM sales_by_product\n"
      ]
    },
    {
      "name": "ds_country",
      "displayName": "Vendas por país",
      "queryLines": [
        "SELECT country, country_code, franchises, orders, revenue, avg_ticket, revenue_share\n",
        "FROM sales_by_country\n"
      ]
    },
    {
      "name": "ds_franchise",
      "displayName": "Desempenho das franquias",
      "queryLines": [
        "SELECT revenue_rank, franchise_id, franchise_name, city, country, size,\n",
        "       latitude, longitude, orders, revenue, avg_ticket, unique_customers, revenue_share\n",
        "FROM franchise_performance\n",
        "ORDER BY revenue_rank, franchise_name\n"
      ]
    },
    {
      "name": "ds_sentiment_mix",
      "displayName": "Distribuição do sentimento",
      "queryLines": [
        "SELECT s.sentiment, SUM(s.reviews) AS reviews\n",
        "FROM sentiment_by_franchise AS f\n",
        "LATERAL VIEW stack(4,\n",
        "  'Positivo', f.positive_reviews,\n",
        "  'Neutro',   f.neutral_reviews,\n",
        "  'Misto',    f.mixed_reviews,\n",
        "  'Negativo', f.negative_reviews) s AS sentiment, reviews\n",
        "GROUP BY s.sentiment\n"
      ]
    },
    {
      "name": "ds_sentiment_franchise",
      "displayName": "Sentimento por franquia",
      "queryLines": [
        "SELECT franchise_name, city, country, reviews, positive_reviews, negative_reviews,\n",
        "       pct_positive, pct_negative, net_sentiment_score\n",
        "FROM sentiment_by_franchise\n",
        "WHERE reviews > 0\n",
        "ORDER BY net_sentiment_score DESC, reviews DESC\n"
      ]
    }
  ],
